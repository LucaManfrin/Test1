---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { getCategoryLabel, getRelatedPosts } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts
    .filter((post) => post.data.published && !post.data.archived)
    .map((post) => ({
      params: { slug: post.slug },
      props: { post },
    }));
}

interface Props {
  post: any;
}

const { post } = Astro.props;
const { Content } = await post.render();
const categoryLabel = await getCategoryLabel(post.data.category);
const relatedPosts = await getRelatedPosts(post.slug, post.data.category);

const dateStr = new Date(post.data.date).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const categorySlug = post.data.category.toLowerCase().replace(/\s+/g, "-");
---

<Base
  title={post.data.title}
  description={post.data.description}
  canonical={`${Astro.site}posts/${post.slug}`}
>
  <article class="post">
    <header class="post-header">
      <h1>{post.data.title}</h1>
      
      <div class="post-meta">
        <time datetime={post.data.date.toISOString()}>{dateStr}</time>
        <span class="separator">•</span>
        <a href={`/category/${categorySlug}`} class="category-link">
          {categoryLabel}
        </a>
        {post.data.author && (
          <>
            <span class="separator">•</span>
            <span class="author">{post.data.author}</span>
          </>
        )}
      </div>

      {post.data.tags.length > 0 && (
        <div class="post-tags">
          {post.data.tags.map((tag: string) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )}
    </header>

    <div class="post-content">
      <Content />
    </div>

    {relatedPosts.length > 0 && (
      <section class="related-posts">
        <h3>Related Posts</h3>
        <ul class="related-list">
          {relatedPosts.map((related) => (
            <li>
              <a href={`/posts/${related.slug}`}>{related.data.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>

  <nav class="post-nav">
    <a href="/" class="nav-link">← Back to All Posts</a>
  </nav>
</Base>

<style>
  .post {
    max-width: 800px;
    margin: 0 auto;
  }

  .post-header {
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .post-header h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.95rem;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .separator {
    color: var(--color-border);
  }

  .category-link {
    color: var(--color-accent);
    font-weight: 500;
  }

  .author {
    font-weight: 500;
  }

  .post-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 0.75rem;
  }

  .tag {
    display: inline-block;
    padding: 0.35rem 0.75rem;
    background-color: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: 0.35rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .post-content {
    margin: 2rem 0;
    line-height: 1.8;
  }

  .post-content :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .post-content :global(h3) {
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .post-content :global(pre) {
    margin-left: -1.5rem;
    margin-right: -1.5rem;
    border-radius: 0;
  }

  .related-posts {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .related-posts h3 {
    margin-bottom: 1rem;
  }

  .related-list {
    list-style: none;
    margin-left: 0;
  }

  .related-list li {
    margin-bottom: 0.75rem;
  }

  .related-list a {
    color: var(--color-accent);
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .related-list a:hover {
    opacity: 0.7;
  }

  .post-nav {
    margin-top: 3rem;
    padding-top: 2rem;
  }

  .nav-link {
    color: var(--color-accent);
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .post-header h1 {
      font-size: 1.75rem;
    }

    .post-content :global(pre) {
      margin-left: -1rem;
      margin-right: -1rem;
    }
  }
</style>
