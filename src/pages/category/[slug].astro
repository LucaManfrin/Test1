---
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import Pagination from "../../components/Pagination.astro";
import { getAllPosts, getCategoryLabel } from "../../lib/posts";
import { CATEGORIES, POSTS_PER_PAGE } from "../../site.config";

export async function getStaticPaths() {
  const allPosts = await getAllPosts();
  const categories = new Set(allPosts.map((p) => p.data.category.toLowerCase().replace(/\s+/g, "-")));

  return Array.from(categories).map((slug) => ({
    params: { slug },
  }));
}

const { slug } = Astro.params;
const allPosts = await getAllPosts();

const categoryBySlug = CATEGORIES.find((c) => c.slug === slug);
if (!categoryBySlug) {
  return Astro.redirect("/404");
}

const categoryPosts = allPosts.filter(
  (post) => post.data.category.toLowerCase().replace(/\s+/g, "-") === slug
);

const totalPages = Math.ceil(categoryPosts.length / POSTS_PER_PAGE);
const posts = categoryPosts.slice(0, POSTS_PER_PAGE);

const categoryLabel = await getCategoryLabel(categoryBySlug.label);
---

<Base
  title={`${categoryLabel} - Posts`}
  description={`All posts in the ${categoryLabel} category`}
>
  <h1>{categoryLabel}</h1>
  <p class="category-count">{categoryPosts.length} posts</p>

  <div class="posts-grid">
    {posts.map((post) => (
      <PostCard
        title={post.data.title}
        description={post.data.description}
        date={post.data.date}
        slug={post.slug}
        category={post.data.category}
        tags={post.data.tags}
        pinned={post.data.pinned}
      />
    ))}
  </div>

  {totalPages > 1 && (
    <Pagination 
      currentPage={1} 
      totalPages={totalPages} 
      baseUrl={`/category/${slug}/`}
    />
  )}
</Base>

<style>
  h1 {
    margin-bottom: 0.5rem;
  }

  .category-count {
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  @media (max-width: 640px) {
    .posts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
