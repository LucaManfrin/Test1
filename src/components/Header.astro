---
import { SITE, CATEGORIES } from "../site.config";

const path = Astro.url.pathname;
---

<header>
  <nav class="navbar">
    <div class="nav-start">
      <a href="/" class="logo">
        <span class="brand-icon">▌</span>
        <span class="brand-text">{SITE.title}</span>
      </a>
    </div>
    
    <div class="nav-center">
      {
        CATEGORIES.map((cat) => (
          <a 
            href={`/category/${cat.slug}`}
            class={`nav-link ${path.includes(`/category/${cat.slug}`) ? "active" : ""}`}
          >
            {cat.label}
          </a>
        ))
      }
    </div>

    <div class="nav-end">
      <a href="/search" class="nav-link icon-link" title="Search">
        🔍
      </a>
      <button id="theme-toggle" class="nav-link icon-link" title="Toggle dark mode">
        🌙
      </button>
    </div>
  </nav>
</header>

<style>
  header {
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .navbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem 1.5rem;
    gap: 2rem;
  }

  .nav-start {
    flex-shrink: 0;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.125rem;
    font-weight: 700;
    text-decoration: none;
    color: var(--color-text);
    transition: opacity 0.2s;
  }

  .logo:hover {
    opacity: 0.7;
  }

  .brand-icon {
    font-size: 1rem;
  }

  .nav-center {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
    justify-content: center;
    flex: 1;
  }

  .nav-end {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }

  .nav-link {
    font-size: 0.95rem;
    color: var(--color-text);
    text-decoration: none;
    transition: color 0.2s;
    border: none;
    background: none;
    cursor: pointer;
    padding: 0;
    font: inherit;
  }

  .nav-link:hover {
    color: var(--color-accent);
  }

  .nav-link.active {
    color: var(--color-accent);
    font-weight: 600;
  }

  .icon-link {
    font-size: 1.1rem;
  }

  @media (max-width: 768px) {
    .navbar {
      flex-wrap: wrap;
      padding: 0.75rem 1rem;
      gap: 1rem;
    }

    .nav-center {
      order: 3;
      width: 100%;
      gap: 1rem;
    }

    .nav-end {
      gap: 0.5rem;
    }

    .brand-text {
      display: none;
    }
  }
</style>

<script>
  const themeToggle = document.getElementById("theme-toggle");
  
  function getTheme() {
    return localStorage.getItem("theme") || "dark";
  }

  function setTheme(theme: string) {
    localStorage.setItem("theme", theme);
    document.documentElement.dataset.theme = theme;
    updateIcon();
  }

  function updateIcon() {
    const theme = getTheme();
    if (themeToggle) {
      themeToggle.textContent = theme === "dark" ? "☀️" : "🌙";
    }
  }

  themeToggle?.addEventListener("click", () => {
    const current = getTheme();
    setTheme(current === "dark" ? "light" : "dark");
  });

  setTheme(getTheme());
</script>
